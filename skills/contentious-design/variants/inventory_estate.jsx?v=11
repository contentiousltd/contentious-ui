          </div>
        )}
      </div>
    </div>);

}

// ─── SVG Donut chart with tooltip panel ───────────────────────────────────
// hoverIdx: which segment to show as "active" with the tooltip card
function DonutChart({ segments, size = 180, hoverIdx = 0 }) {
  const cx = size / 2,cy = size / 2;
  const oR = size * 0.44,iR = size * 0.27;
  const GAP = 0.022;
  const total = segments.reduce((s, x) => s + x.value, 0);
  let ang = -Math.PI / 2;
  const arcs = segments.map((seg) => {
    const span = seg.value / total * (2 * Math.PI) - GAP;
    const a1 = ang,a2 = ang + span;
    ang = a2 + GAP;
    const large = span > Math.PI ? 1 : 0;
    const f = (n) => n.toFixed(2);
    const path = [
    `M ${f(cx + oR * Math.cos(a1))} ${f(cy + oR * Math.sin(a1))}`,
    `A ${f(oR)} ${f(oR)} 0 ${large} 1 ${f(cx + oR * Math.cos(a2))} ${f(cy + oR * Math.sin(a2))}`,
    `L ${f(cx + iR * Math.cos(a2))} ${f(cy + iR * Math.sin(a2))}`,
    `A ${f(iR)} ${f(iR)} 0 ${large} 0 ${f(cx + iR * Math.cos(a1))} ${f(cy + iR * Math.sin(a1))}`,
    'Z'].
    join(' ');
    return { ...seg, path };
  });
  const hov = segments[hoverIdx];
  const pct = Math.round(hov.value / total * 100);
  return (
    <div>
      <div style={{ display: 'flex', alignItems: 'flex-start', gap: 16 }}>
        <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} style={{ flexShrink: 0 }}>
          {arcs.map((arc, i) =>
          <path key={i} d={arc.path} fill={arc.color}
          opacity={i === hoverIdx ? 1 : 0.78}
          stroke="var(--limestone-pale)" strokeWidth={2} />

          )}
        </svg>
        <div style={{
          background: 'var(--limestone-pale)', border: '1px solid var(--limestone-extra-dark)',
          borderRadius: 6, padding: '12px 14px',
          boxShadow: '0 3px 12px rgba(0,0,0,0.09)', marginTop: 20, flexShrink: 0
        }}>
          <div style={{ fontFamily: 'var(--font-heading)', fontSize: 13, fontWeight: 500, color: 'var(--gloaming-dark)', marginBottom: 6 }}>{hov.label}</div>
          <div style={{ display: 'flex', alignItems: 'center', gap: 6, paddingBottom: 7, marginBottom: 7, borderBottom: '1px solid var(--limestone-extra-dark)' }}>
            <div style={{ width: 10, height: 10, borderRadius: 2, background: hov.color }} />
          </div>
          <div style={{ fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--gloaming)' }}>{hov.value.toLocaleString()} pages</div>
          <div style={{ fontFamily: 'var(--font-mono)', fontSize: 10, color: 'var(--gloaming-pale)', marginTop: 3 }}>{pct}%</div>
        </div>
      </div>
      <div style={{ display: 'flex', flexWrap: 'wrap', gap: '5px 10px', marginTop: 10 }}>
        {segments.map((s, i) =>
        <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
            <div style={{ width: 8, height: 8, borderRadius: 2, flexShrink: 0, background: s.color }} />
            <span style={{ fontFamily: 'var(--font-mono)', fontSize: 9, color: 'var(--gloaming-pale)' }}>{s.label}</span>
          </div>
        )}
      </div>
    </div>);

}

