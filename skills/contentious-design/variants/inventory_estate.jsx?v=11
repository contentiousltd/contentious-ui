// ─── Overall / aggregate card ─────────────────────────────────────────────
function OverallCard({ sources, accent }) {
  const totalCandidates = sources.reduce((a, s) => a + s.candidates, 0);
  const totalCatalogue = sources.reduce((a, s) => a + s.catalogue, 0);
  const totalRaw = sources.reduce((a, s) => a + s.raw, 0);
  const totalFiltered = totalRaw - totalCandidates;

  // Aggregate freshness across all properties
  const aggF = sources.reduce((a, s) => ({
    under6: a.under6 + s.freshness.under6,
    sixTo24: a.sixTo24 + s.freshness.sixTo24,
    over24: a.over24 + s.freshness.over24
  }), { under6: 0, sixTo24: 0, over24: 0 });

  // Aggregate sections: combine by name, keep top 5 + Other
  const sectionMap = {};
  sources.forEach((s) => s.sections.forEach((sec) => {
    sectionMap[sec.name] = (sectionMap[sec.name] || 0) + sec.count;
  }));
  const sortedSections = Object.entries(sectionMap).
  sort(([, a], [, b]) => b - a);
  const top5 = sortedSections.slice(0, 5).map(([name, count]) => ({ name, count }));
  const otherCount = sortedSections.slice(5).reduce((a, [, c]) => a + c, 0);
  if (otherCount > 0) top5.push({ name: 'Other', count: otherCount });

  const SECTION_COLORS = ['var(--wave-600)', 'var(--sapling-500)', 'var(--sunshine-500)', 'var(--sorbet-500)', 'var(--gloaming-400)', 'var(--limestone-extra-dark)'];

  return (
    <div style={{ background: 'var(--limestone-pale)', border: '1px solid var(--limestone-extra-dark)', borderRadius: 10, overflow: 'hidden', marginBottom: 16 }}>
      <div style={{ padding: '18px 24px' }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
          <div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 4 }}>
              <span style={{ fontFamily: 'var(--font-heading-display)', fontSize: 22, color: 'var(--gloaming-dark)' }}>The whole estate</span>
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: 10, letterSpacing: '.06em', textTransform: 'uppercase', padding: '2px 8px', borderRadius: 3, background: 'var(--limestone-extra-dark)', color: 'var(--gloaming-pale)' }}>{sources.length} properties</span>
            </div>
            <div style={{ fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--gloaming-pale)' }}>
              {sources.map((s) => s.domain).join(' · ')}
            </div>
          </div>
        </div>
        <div style={{ display: 'flex', gap: 36, marginTop: 16, paddingTop: 16, borderTop: '1px solid var(--limestone-extra-dark)' }}>
          {[
          { val: totalCandidates.toLocaleString(), label: 'Content pages', color: 'var(--gloaming-dark)' },
          { val: totalCatalogue.toLocaleString(), label: 'In catalogue', color: 'var(--sapling-extra-dark)' },
          { val: totalFiltered.toLocaleString(), label: 'Filtered URLs', color: 'var(--gloaming-pale)' }].
          map((s) =>
          <div key={s.label}>
              <div style={{ fontFamily: 'var(--font-heading-display)', fontSize: 30, color: s.color, lineHeight: 1 }}>{s.val}</div>
              <div style={{ fontFamily: 'var(--font-mono)', fontSize: 10, letterSpacing: '.06em', textTransform: 'uppercase', color: 'var(--gloaming-pale)', marginTop: 3 }}>{s.label}</div>
            </div>
          )}
        </div>
      </div>
      <div style={{ borderTop: '1px solid var(--limestone-extra-dark)', padding: '18px 24px 20px', display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 28 }}>
        <div>
          <div style={{ fontFamily: 'var(--font-mono)', fontSize: 10, letterSpacing: '.08em', textTransform: 'uppercase', color: 'var(--gloaming-pale)', marginBottom: 12 }}>Pages by property</div>
          <DonutChart size={280} hoverIdx={0}
          segments={sources.map((s, i) => ({
            label: s.domain,
            value: s.candidates,
            color: ['var(--wave-600)', 'var(--sapling-500)', 'var(--sunshine-500)'][i]
          }))} />
          
        </div>
        <div>
          <div style={{ fontFamily: 'var(--font-mono)', fontSize: 10, letterSpacing: '.08em', textTransform: 'uppercase', color: 'var(--gloaming-pale)', marginBottom: 12 }}>Content freshness — all properties</div>
          <DonutChart size={280} hoverIdx={1}
          segments={[
          { label: '< 6 months', value: aggF.under6, color: 'var(--sapling-500)' },
          { label: '6–24 months', value: aggF.sixTo24, color: 'var(--sunshine-500)' },
          { label: '> 24 months', value: aggF.over24, color: 'var(--fire-500)' }]
          } />
          
          <div style={{ marginTop: 8, fontSize: 11, color: 'var(--gloaming-pale)', fontStyle: 'italic' }}>From sitemap lastmod — indicator, not ground truth.</div>
        </div>
      </div>
    </div>);

}

