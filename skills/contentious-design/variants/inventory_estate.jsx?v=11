function FreshnessBar({ under6, sixTo24, over24 }) {
  const total = under6 + sixTo24 + over24;
  if (!total) return <span style={{ fontSize: 11, color: 'var(--gloaming-pale)' }}>No lastmod data</span>;
  const pct = (n) => `${Math.round(n / total * 100)}%`;
  const bands = [['var(--sapling-400)', pct(under6), '< 6 mo'], ['var(--sunshine-400)', pct(sixTo24), '6–24 mo'], ['var(--fire-300)', pct(over24), '> 24 mo']];
  return (
    <div>
      <div style={{ display: 'flex', height: 6, borderRadius: 3, overflow: 'hidden', gap: 1 }}>
        <div style={{ flex: under6, background: 'var(--sapling-400)' }} />
        <div style={{ flex: sixTo24, background: 'var(--sunshine-400)' }} />
        <div style={{ flex: over24, background: 'var(--fire-300)' }} />
