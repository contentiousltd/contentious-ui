// ─── URL browser helpers ─────────────────────────────────────────────────
function StatusPill({ status }) {
  const S = {
    candidate: { label: 'Candidate', bg: 'var(--sapling-100)', color: 'var(--sapling-extra-dark)' },
    excluded_auto: { label: 'Auto-excluded', bg: 'var(--limestone)', color: 'var(--gloaming-pale)' },
    excluded_manual: { label: 'Manually excluded', bg: 'var(--sunshine-100)', color: 'var(--sunshine-extra-dark)' }
  };
  const s = S[status] || { label: status, bg: 'var(--limestone-extra-dark)', color: 'var(--gloaming-pale)' };
  return <span style={{ fontFamily: 'var(--font-mono)', fontSize: 10, letterSpacing: '.04em', textTransform: 'uppercase', padding: '2px 7px', borderRadius: 3, background: s.bg, color: s.color }}>{s.label}</span>;
}

function TypeTag({ type }) {
  const T = { content: 'var(--gloaming)', file_entity: 'var(--gloaming-pale)', node_id: 'var(--gloaming-pale)', translation: 'var(--gloaming-pale)', system: 'var(--gloaming-pale)' };
  const labels = { content: 'Content', file_entity: 'File entity', node_id: 'Node ID', translation: 'Translation', system: 'System' };
  return <span style={{ fontFamily: 'var(--font-mono)', fontSize: 11, color: T[type] || 'var(--gloaming-pale)' }}>{labels[type] || type}</span>;
}

function HttpBadge({ code }) {
  if (!code) return <span style={{ color: 'var(--limestone-extra-dark)', fontFamily: 'var(--font-mono)', fontSize: 11 }}>—</span>;
  const color = code < 300 ? 'var(--sapling-extra-dark)' : code < 400 ? 'var(--sunshine-extra-dark)' : 'var(--fire-dark)';
  return <span style={{ fontFamily: 'var(--font-mono)', fontSize: 11, color }}>{code}</span>;
}

